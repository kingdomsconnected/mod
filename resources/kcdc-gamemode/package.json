{
  "name": "kcdc-gamemode",
  "license": "SEE LICENSE IN LICENSE.txt",
  "version": "1.1.0",
  "author": "Kingdoms Connected",
  "description": "Default Kingdoms Connected gamemode: every command a bare server answers and the debug panel its clients open, written against the public scripting API",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:pots": "npm run build && node --test tests/pots.test.cjs",
    "test:follow": "npm run build && node --test tests/follow.test.cjs",
    "test:dice": "npm run build && node --test tests/dice.test.cjs",
    "test:npc": "npm run build && node --test tests/npcdemo.test.cjs",
    "test:combat": "npm run build && node --test tests/combat.test.cjs",
    "test:builder": "npm run build && node --test tests/builder.test.cjs",
    "test:customitems": "npm run build && node --test tests/customitems.test.cjs",
    "test:woodcutting": "npm run build && node --test tests/woodcutting.test.cjs",
    "dev": "node scripts/watch.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "watch:client": "tsc -p src/client/tsconfig.json --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@kingdomsconnected/types": "file:../../scripting-api",
    "typescript": "^5.9.2"
  },
  "mafiahub": {
    "category": "example",
    "serverScripts": [
      "dist/server/index.js"
    ],
    "clientScripts": [
      "dist/client/index.js"
    ],
    "files": [
      "dist/client/**",
      "ui/**",
      "assets/**"
    ],
    "priority": 10
  }
}
